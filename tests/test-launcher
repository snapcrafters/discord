#!/bin/bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmpdir="$(mktemp -d)"
trap 'rm -rf "${tmpdir}"' EXIT

snap_root="${tmpdir}/snap"
mock_bin="${tmpdir}/bin"
state_dir="${tmpdir}/state"
mkdir -p "${snap_root}/bin" "${snap_root}/meta/hooks" \
  "${snap_root}/usr/share/discord" "${mock_bin}" "${state_dir}"
cp "${repo_root}/snap/local/bin/launcher" "${snap_root}/bin/launcher"

if [[ ! -f "${repo_root}/snap/hooks/configure" ]]; then
  echo "FAIL: configure hook is missing" >&2
  exit 1
fi
cp "${repo_root}/snap/hooks/configure" "${snap_root}/meta/hooks/configure"

cat > "${mock_bin}/snapctl" <<'EOF'
#!/bin/bash
set -euo pipefail
case "$1" in
  get)
    if [[ -f "${SNAP_TEST_STATE}/$2" ]]; then
      cat "${SNAP_TEST_STATE}/$2"
    fi
    ;;
  set)
    key="${2%%=*}"
    value="${2#*=}"
    printf '%s' "${value}" > "${SNAP_TEST_STATE}/${key}"
    ;;
  *)
    echo "unexpected snapctl invocation: $*" >&2
    exit 2
    ;;
esac
EOF
chmod 0755 "${mock_bin}/snapctl"

cat > "${snap_root}/usr/share/discord/Discord" <<'EOF'
#!/bin/bash
printf '%s\n' "$@" > "${SNAP_TEST_ARGS}"
EOF
chmod 0755 "${snap_root}/usr/share/discord/Discord"

run_launcher() {
  local output="$1"
  shift
  SNAP="${snap_root}" \
  SNAP_TEST_ARGS="${output}" \
  SNAP_TEST_STATE="${state_dir}" \
  PATH="${mock_bin}:${PATH}" \
    "${snap_root}/bin/launcher" "$@"
}

assert_args() {
  local actual="$1"
  local expected="$2"
  if ! diff -u <(printf '%s' "${expected}") "${actual}"; then
    echo "FAIL: launcher arguments differed" >&2
    exit 1
  fi
}

# An unset option must preserve the historical X11 behaviour.
default_args="${tmpdir}/default-args"
run_launcher "${default_args}" --example "two words"
assert_args "${default_args}" $'--use-tray-icon\n--no-sandbox\n--disable-seccomp-filter-sandbox\n--ozone-platform=x11\n--example\ntwo words\n'
[[ "$(cat "${state_dir}/use-x11")" == "true" ]]

# Users can explicitly opt in to native Wayland by disabling the X11 flag.
printf 'false' > "${state_dir}/use-x11"
wayland_args="${tmpdir}/wayland-args"
run_launcher "${wayland_args}" --example
assert_args "${wayland_args}" $'--use-tray-icon\n--no-sandbox\n--disable-seccomp-filter-sandbox\n--example\n'
[[ "$(cat "${state_dir}/use-x11")" == "false" ]]

echo "PASS: launcher honours the use-x11 snap setting"
